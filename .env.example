# Copy this file to .env and fill in real values. Never commit .env.
BASE_URL=https://dev-nx.thekanaa.com
LOCALE_PATH=/en-sa/

# The homepage QA bot (tests/homepage) targets PRODUCTION on purpose, separately
# from BASE_URL above — see CLAUDE.md "Two different targets, on purpose".
# HOMEPAGE_LOCALE selects which locale a given run tests: "en" or "ar".
HOMEPAGE_BASE_URL=https://thekanaa.com
HOMEPAGE_LOCALE=en

TEST_USER_EMAIL=priyanka@iamtechie.com
TEST_USER_PASSWORD=1234

# Safety switch: set to "true" only when you intentionally want the checkout
# test to click through to placing a real order. Defaults to false so CI/
# scheduled runs never place orders by accident.
RUN_FULL_CHECKOUT=false
