# PDP QA Bot Configuration

# Base URLs
BASE_URL=https://thekanaa.com/en-sa/
BASE_URL_AR=https://thekanaa.com/ar-sa/

# Test Product URLs - Set one of these when running tests
# PDP_URL=https://thekanaa.com/en-sa/p/your-product-slug

# Environment
ENVIRONMENT=staging

# Playwright Configuration
HEADLESS=true
SLOW_MO=0

# Report Output
REPORTS_DIR=reports

# Evidence Collection
COLLECT_SCREENSHOTS=true
COLLECT_VIDEOS=true
COLLECT_TRACES=false
COLLECT_CONSOLE=true
COLLECT_NETWORK=true

# Test Configuration
TEST_TIMEOUT=60000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# Multi-language Testing
TEST_ENGLISH=true
TEST_ARABIC=false

# Multi-browser Testing
TEST_CHROMIUM=true
TEST_FIREFOX=true
TEST_WEBKIT=true

# Multi-viewport Testing
TEST_DESKTOP=true
TEST_TABLET=true
TEST_MOBILE=true

# Bug Reporting
AUTO_REPORT_BUGS=true
BUG_SEVERITY_THRESHOLD=Low

# Performance Testing
COLLECT_METRICS=true
WARN_IF_LOAD_TIME_EXCEEDS=3000
WARN_IF_DOM_READY_EXCEEDS=2000

# Accessibility Testing
CHECK_ACCESSIBILITY=true
FAIL_ON_A11Y_ISSUES=false
