{
  "name": "qa-homepage-agent",
  "version": "1.0.0",
  "description": "Autonomous QA testing bot for ecommerce homepage - Thekanaa",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/homepage/smoke-test.spec.ts",
    "test:discovery": "playwright test tests/homepage/homepage-discovery.spec.ts",
    "test:navigation": "playwright test tests/homepage/homepage-navigation.spec.ts",
    "test:buttons": "playwright test tests/homepage/homepage-buttons.spec.ts",
    "test:links": "playwright test tests/homepage/homepage-links.spec.ts",
    "test:sliders": "playwright test tests/homepage/homepage-sliders.spec.ts",
    "test:products": "playwright test tests/homepage/homepage-products.spec.ts",
    "test:ui": "playwright test tests/homepage/homepage-ui.spec.ts",
    "test:responsive": "playwright test tests/homepage/homepage-responsive.spec.ts",
    "test:negative": "playwright test tests/homepage/homepage-negative.spec.ts",
    "test:regression": "playwright test tests/homepage/homepage-regression.spec.ts",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:trace": "playwright test --trace on",
    "test:pdp:discovery": "playwright test tests/pdp/pdp-discovery.spec.ts --config=pdp-playwright.config.ts",
    "test:pdp:smoke": "playwright test tests/pdp/pdp-smoke.spec.ts --config=pdp-playwright.config.ts",
    "test:pdp:full": "playwright test tests/pdp/pdp-full.spec.ts --config=pdp-playwright.config.ts",
    "test:pdp:headed": "playwright test tests/pdp/ --config=pdp-playwright.config.ts --headed",
    "test:pdp:debug": "playwright test tests/pdp/ --config=pdp-playwright.config.ts --debug",
    "test:pdp:trace": "playwright test tests/pdp/ --config=pdp-playwright.config.ts --trace on",
    "test:plp:discovery": "playwright test tests/plp/plp-discovery.spec.ts",
    "test:plp:smoke": "playwright test tests/plp/plp-smoke.spec.ts",
    "test:plp:navigation": "playwright test tests/plp/plp-navigation.spec.ts",
    "test:plp:filters": "playwright test tests/plp/plp-filters.spec.ts",
    "test:plp:sorting": "playwright test tests/plp/plp-sorting.spec.ts",
    "test:plp:product-cards": "playwright test tests/plp/plp-product-cards.spec.ts",
    "test:plp:pagination": "playwright test tests/plp/plp-pagination.spec.ts",
    "test:plp:responsive": "playwright test tests/plp/plp-responsive.spec.ts",
    "test:plp:localization": "playwright test tests/plp/plp-localization.spec.ts",
    "test:plp:performance": "playwright test tests/plp/plp-performance.spec.ts",
    "test:plp:business": "playwright test tests/plp/plp-business.spec.ts",
    "test:plp:accessibility": "playwright test tests/plp/plp-accessibility.spec.ts",
    "test:plp:regression": "playwright test tests/plp/plp-regression.spec.ts",
    "test:plp:full": "playwright test tests/plp/",
    "test:plp:headed": "playwright test tests/plp/ --headed",
    "test:plp:debug": "playwright test tests/plp/ --debug",
    "test:plp:trace": "playwright test tests/plp/ --trace on",
    "test:plp:report": "node scripts/generate-plp-report.js"
  },
  "keywords": ["QA", "testing", "Playwright", "ecommerce", "automation"],
  "author": "Claude QA Agent",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
