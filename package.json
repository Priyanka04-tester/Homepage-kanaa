{
  "name": "kanaa-test-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Automated testing bot for the Kanaa e-commerce site (dev-nx.thekanaa.com)",
  "scripts": {
    "test": "playwright test tests/e2e tests/api --grep-invert @otp",
    "test:e2e": "playwright test tests/e2e --grep-invert @otp",
    "test:e2e:full": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test tests/e2e --headed --grep-invert @otp",
    "report": "playwright show-report",
    "discover:homepage": "playwright test tests/homepage/homepage-discovery.spec.js --project=chromium",
    "plan:homepage": "node scripts/generate-test-plan.js",
    "test:homepage": "playwright test tests/homepage --project=chromium --grep-invert \"Cross-browser homepage smoke\"",
    "test:homepage:browsers": "playwright test --config=playwright.homepage.config.js homepage-browsers.spec.js",
    "regress:homepage": "node scripts/run-regression.js",
    "retest:homepage": "node scripts/retest-bug.js",
    "bugs:homepage": "node scripts/file-bugs.js",
    "report:homepage": "node scripts/generate-report.js",
    "monitor": "node monitoring/healthcheck.js",
    "load:light": "artillery run load/artillery-browse.yml",
    "load:api": "artillery run load/artillery-api.yml",
    "install:browsers": "playwright install chromium",
    "install:browsers:all": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "artillery": "^2.0.19",
    "dotenv": "^16.4.5"
  }
}
